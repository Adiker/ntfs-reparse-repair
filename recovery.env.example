# Skopiuj do recovery.env i uzupełnij na podstawie odczytowego inwentarza.
# Nie commituj recovery.env — może zawierać identyfikatory Twojego sprzętu.
# Plik jest odczytywany przez ścisły parser: KEY=VALUE, bez poleceń powłoki.
# Wartości zawierające znaki specjalne ujmij w jedną parę apostrofów.

DISK_BY_ID='/dev/disk/by-id/wwn-0xREPLACE_ME'
PARTITION_BY_ID='/dev/disk/by-id/wwn-0xREPLACE_ME-part1'
EXPECTED_MODEL='REPLACE_ME'
EXPECTED_SERIAL='REPLACE_ME'
EXPECTED_DISK_BYTES='0'
EXPECTED_PARTITION_BYTES='0'
EXPECTED_PARTUUID='replace-me'
EXPECTED_KEYS='0'

BACKUP_IMAGE='/path/on/another/disk/ntfs-metadata.img'
BACKUP_SHA256='replace-me'

AUDIT_BIN='./build/ntfs-r-audit'
REBUILD_BIN='./build/ntfs-r-rebuild'
ARTIFACT_DIR='./artifacts'
